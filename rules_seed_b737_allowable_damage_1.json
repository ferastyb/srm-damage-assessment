  "rules": [
    {
      "rule_code": "B737-AD1-REQ-001",
      "title": "Dent eligibility requirements for Table 102 usage",
      "damage_type": "dent",
      "structure_area": "fuselage_skin",
      "disposition": "ENGINEERING_REVIEW",
      "severity": "engineering",
      "srm_ref": "53-00-01 Allowable Damage 1, Table 102 footnote/requirements",
      "logic": {
        "any": [
          { "field": "has_crack", "op": "==", "value": true },
          { "field": "has_sharp_crease", "op": "==", "value": true },
          { "field": "has_gouge", "op": "==", "value": true },
          { "field": "has_hole_or_puncture", "op": "==", "value": true },
          { "field": "fastener_condition", "op": "in", "value": ["broken", "pulled", "loose"] },
          { "field": "has_elongated_fastener_hole", "op": "==", "value": true },
          { "field": "has_substructure_damage", "op": "==", "value": true },
          { "field": "is_common_to_stringer_or_frame", "op": "==", "value": true },
          { "field": "distance_from_cutout_in", "op": "<", "value": 10.0 },
          { "field": "distance_from_skin_splice_in", "op": "<", "value": 3.0 }
        ]
      },
      "actions": [
        "Table 102 not applicable or requirements not met.",
        "Escalate to engineering / refer to SRM for alternate repair or detailed evaluation."
      ]
    },

    {
      "rule_code": "B737-AD1-T102-001",
      "title": "Allowable: depth < 3.175 mm and W/Y > 30",
      "damage_type": "dent",
      "structure_area": "fuselage_skin",
      "disposition": "ALLOWABLE",
      "severity": "info",
      "srm_ref": "53-00-01 Table 102",
      "logic": {
        "all": [
          { "field": "depth_mm", "op": "<", "value": 3.175 },
          { "field": "wy_ratio", "op": ">", "value": 30 },
          { "field": "has_crack", "op": "==", "value": false }
        ]
      },
      "actions": [
        "Allowable damage. No repair necessary."
      ]
    },

    {
      "rule_code": "B737-AD1-T102-002",
      "title": "Repair delayed: depth < 3.175 mm and 15 < W/Y < 30",
      "damage_type": "dent",
      "structure_area": "fuselage_skin",
      "disposition": "REPAIR_DELAYED",
      "severity": "warning",
      "srm_ref": "53-00-01 Table 102",
      "logic": {
        "all": [
          { "field": "depth_mm", "op": "<", "value": 3.175 },
          { "field": "wy_ratio", "op": ">", "value": 15 },
          { "field": "wy_ratio", "op": "<", "value": 30 },
          { "field": "has_crack", "op": "==", "value": false }
        ]
      },
      "actions": [
        "Dent must be repaired permanently, but repair may be deferred with inspections.",
